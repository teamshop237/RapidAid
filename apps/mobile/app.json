{
  "expo": {
    "name": "RapidAid",
    "slug": "rapidaid",
    "version": "0.1.0",
    "scheme": "rapidaid",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#176B65",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101616",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "android": {
      "package": "com.rapidaid.app",
      "adaptiveIcon": {
        "backgroundColor": "#176B65",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
